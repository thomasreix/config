screenshot-path "~/screenshots/%y-%m-%d_%H-%M-%S.png"

binds {
    Mod+Return { spawn "foot"; }
    Mod+Shift+Return { spawn "fuzzel"; }
    Mod+Backspace repeat=false { close-window; }
    Mod+Grave repeat=false { toggle-overview; }

    Mod+F1 { quit; }
    Mod+F2 { power-off-monitors; }
    Mod+F10     { toggle-window-floating; }
    Mod+Shift+F10 { switch-focus-between-floating-and-tiling; }
    Mod+F11 { maximize-column; }
    Mod+F12 { expand-column-to-available-width; }

	Super+W { spawn "librewolf"; }
    
    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }

    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-workspace-up; }
    Mod+Down  { focus-workspace-down; }

	Mod+WheelScrollLeft       { focus-column-left; }
	Mod+WheelScrollRight      { focus-column-right; }
	Mod+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
    Mod+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }
    
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-window-down; }
    Mod+SHift+Up    { move-column-to-workspace-up; }
    Mod+Shift+Down  { move-column-to-workspace-down; }

    Mod+Shift+WheelScrollLeft  cooldown-ms=150 { move-column-left; }
    Mod+Shift+WheelScrollRight cooldown-ms=150 { move-column-right; }
    Mod+Shift+WheelScrollUp    cooldown-ms=150 { move-column-to-workspace-up; }
    Mod+Shift+WheelScrollDown  cooldown-ms=150 { move-column-to-workspace-down; }

    Mod+Ctrl+Left        { focus-column-first; }
    Mod+Ctrl+Right       { focus-column-last; }
    Mod+Ctrl+Shift+Left  { move-column-to-first; }
    Mod+Ctrl+Shift+Right { move-column-to-last; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }

    Mod+Tab { focus-workspace-previous; }

    Mod+Alt+Left  { consume-or-expel-window-left; }
    Mod+Alt+Right { consume-or-expel-window-right; }
    Mod+Alt+Shift+Left  { consume-window-into-column; }
    Mod+Alt+Shift+Right { expel-window-from-column; }
}
