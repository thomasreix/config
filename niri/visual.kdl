prefer-no-csd

hotkey-overlay {
    skip-at-startup
}

layout {
    gaps 0
    center-focused-column "never"

    preset-column-widths {
        proportion 0.5000
        proportion 0.9999
    }
    default-column-width { proportion 0.5; }

    background-color "#0f0f0f"

    focus-ring {
        off
        width 0
        active-color "#ef934d"
        inactive-color "#0f0f0f"
    }
    border {
        off
    }
    insert-hint {
        off
    }
}

animations {
    off
}
